{
	"name": "@oh-my-pi/pi-server",
	"version": "18.4.3",
	"description": "Transport-neutral session state machine for remote sessions",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		},
		"./*.js": "./src/*.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE"
	],
	"sideEffects": false,
	"scripts": {
		"check": "bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit"
	},
	"keywords": [
		"protocol",
		"server",
		"session",
		"transport",
		"socket"
	],
	"author": { "name": "Stencil Labs, Inc.", "url": "https://stencil.so" },
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/server"
	},
	"engines": {
		"node": ">=20",
		"bun": ">=1.3.14"
	},
	"dependencies": {
		"@oh-my-pi/chord": "catalog:",
		"@oh-my-pi/pi-protocol": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	}
}