{
	"name": "@ultraworkers/pi-durable",
	"version": "18.4.3",
	"description": "Durable conversation, task, and document runtime",
	"keywords": [
		"durable-execution",
		"agents",
		"conversations",
		"tasks"
	],
	"homepage": "https://omp.sh",
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Stencil Labs, Inc.",
		"url": "https://stencil.so"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/durable"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./env": {
			"types": "./src/env/index.ts",
			"import": "./src/env/index.ts"
		},
		"./storage/memory": {
			"types": "./src/storage/memory.ts",
			"import": "./src/storage/memory.ts"
		},
		"./storage/jsonl": {
			"types": "./src/storage/jsonl/index.ts",
			"import": "./src/storage/jsonl/index.ts"
		},
		"./storage/sqlite": {
			"types": "./src/storage/sqlite/index.ts",
			"import": "./src/storage/sqlite/index.ts"
		},
		"./testing": {
			"types": "./src/testing/index.ts",
			"import": "./src/testing/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		},
		"./*.js": "./src/*.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.ts' 'test/**/*.ts' && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.ts' 'test/**/*.ts'",
		"bench:storage": "bun --conditions=source test/storage.bench.ts",
		"bench:storage:memory": "bun --conditions=source test/storage-memory.ts",
		"test": "bun test --parallel"
	},
	"dependencies": {
		"@ultraworkers/chord": "catalog:",
		"@oh-my-pi/pi-catalog": "catalog:",
		"@oh-my-pi/pi-ai": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=20"
	}
}