{
	"name": "@ultraworkers/pi-client",
	"version": "18.4.3",
	"description": "Transport-neutral client for remote omp sessions over framed CBOR bytes",
	"keywords": [
		"binary",
		"cbor",
		"client",
		"protocol"
	],
	"homepage": "https://omp.sh",
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Stencil Labs, Inc.",
		"url": "https://stencil.so"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/client"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./unix": {
			"types": "./src/unix.ts",
			"import": "./src/unix.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		},
		"./*.js": "./src/*.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'",
		"test": "bun test --parallel"
	},
	"dependencies": {
		"@ultraworkers/chord": "catalog:",
		"@ultraworkers/pi-protocol": "catalog:"
	},
	"devDependencies": {
		"@ultraworkers/pi-server": "catalog:",
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=20"
	}
}
