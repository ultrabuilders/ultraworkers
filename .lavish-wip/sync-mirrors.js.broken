#!/usr/bin/env bun
// Regenerate the milestone copies embedded in COMPREHENSIVE_PLAN_FOR_OMP_UPGRADE.md
// from the standalone milestone plans.
//
// WHY A SCRIPT: the master embeds a near-verbatim copy of each milestone plan. Every
// hand-sync pass left regions behind — 85 divergent regions at one point, 45 after a
// repair pass whose own verifier counted them differently. Prose synced to prose is what
// produced the drift. The standalone file is the source of truth.
//
// BOUNDARY RULE (this is where the first version of this script was wrong):
//   A milestone's region runs from its own h1 to the NEXT MILESTONE h1 — not to the
//   next h1 of any kind. Several milestones carry their back matter under a separate
//   h1 ("# RỦI RO, CÂU HỎI MỞ VÀ ĐỊNH NGHĨA HOÀN THÀNH", "# Phụ lục — …"), and those
//   belong to the milestone above them. Cutting at the next h1 orphaned them.
//   M1B is deliberately NOT embedded; the master links to its file instead.
//
// Usage:  bun .lavish-wip/sync-mirrors.js [--check]
import * as fs from "node:fs"
import * as path from "node:path"

const BASE = path.resolve(import.meta.dir, "..")
const MASTER = path.join(BASE, "COMPREHENSIVE_PLAN_FOR_OMP_UPGRADE.md")
const CHECK = process.argv.includes("--check")

// Only these milestones are embedded. M1B is intentionally absent.
const EMBEDDED = ["1", "2", "3", "4", "5", "6", "7"]

const lines = fs.readFileSync(MASTER, "utf8").split("\n")

/** Real h1s only — a `# comment` inside a bash fence is not a heading. */
function h1s(rows) {
	const out = []
	let inside = false
	for (let i = 0; i < rows.length; i++) {
		if (rows[i].startsWith("```")) {
			inside = !inside
			continue
		}
		if (!inside && rows[i].startsWith("# ")) out.push(i)
	}
	return out
}

const heads = h1s(lines)
// A milestone h1 carries BOTH the phrase "KẾ HOẠCH THỰC THIỆN" and a "MILESTONE n"
// token — in EITHER order. M1 is "# KẾ HOẠCH THỰC THIỆN — MILESTONE 1: …"; M4 is
// "# MILESTONE 4 — … · KẾ HOẠCH THỰC THIỆN". Matching one order only silently
// dropped M4 — the count guard caught it before anything was written.
const milestoneHeads = heads
	.filter(i => lines[i].includes("KẾ HOẠCH THỰC THIỆN") && /MILESTONE \d/.test(lines[i]))
	.map(i => ({ i, n: lines[i].match(/MILESTONE (\d+B?)/)[1] }))

const regions = []
for (const h of milestoneHeads) {
	const next = milestoneHeads.find(x => x.i > h.i)
	regions.push({ n: h.n, start: h.i, end: next ? next.i : lines.length })
}

if (regions.length !== EMBEDDED.length) {
	console.error(`expected ${EMBEDDED.length} embedded milestone copies, found ${regions.length}`)
	for (const r of regions) console.error(`  MILESTONE ${r.n} at line ${r.start + 1}`)
	process.exit(1)
}

const rebuilt = lines.slice()
let drifted = 0
let same = 0

for (const r of [...regions].sort((a, b) => b.start - a.start)) {
	const file = `MILESTONE_${r.n}_EXECUTION_PLAN.md`
	const src = path.join(BASE, file)
	if (!fs.existsSync(src)) {
		console.log(`  ${file}: standalone missing — copy left untouched`)
		continue
	}
	const body = fs.readFileSync(src, "utf8").replace(/\s+$/, "")
	const current = lines.slice(r.start, r.end).join("\n").replace(/\s+$/, "")
	if (current === body) {
		same++
		continue
	}
	drifted++
	const delta = body.split("\n").length - (r.end - r.start)
	console.log(`  ${file}: copy ${r.end - r.start} → source ${body.split("\n").length} (${delta >= 0 ? "+" : ""}${delta})`)
	if (!CHECK) rebuilt.splice(r.start, r.end - r.start, ...body.split("\n"))
}

console.log(`\n  ${same} identical · ${drifted} drifted`)

if (CHECK) {
	if (drifted > 0) {
		console.log("\nDRIFT PRESENT — rerun without --check")
		process.exit(1)
	}
	console.log("\nall embedded copies match their standalone source")
} else {
	fs.writeFileSync(MASTER, rebuilt.join("\n"))
	console.log(`\nregenerated: ${MASTER}`)
	console.log(`  ${lines.length} → ${rebuilt.length} lines`)
}
